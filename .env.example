# Public, build-time CMS URL. Do not put passwords or API secrets in VITE_ variables.
# Keep this value while WordPress is still installed at the current address.
VITE_WORDPRESS_URL=https://motorhearts.testingweblink.com

# AFTER WordPress has been migrated and verified on the CMS subdomain, use instead:
# VITE_WORDPRESS_URL=https://cms.motorhearts.testingweblink.com

# Copy to .env.local for a local production build, or set the variable in your
# frontend build/deployment platform. Rebuild and redeploy React after changes.
# Use the WordPress installation base URL, not /wp-admin or /wp-json.
# No frontend URL variable is needed: React links use the visitor's current origin.
