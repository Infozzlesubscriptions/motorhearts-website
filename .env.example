# Vercel is the public React frontend: https://motorhearts-website.vercel.app/
# Hestia hosts WordPress only. This public URL is not a credential or secret.
VITE_WORDPRESS_URL=https://motorhearts.testingweblink.com

# Set the same value in Vercel Project Settings > Environment Variables, then
# redeploy. It is embedded at build time, not read from Hestia's PHP environment.
# Do not set this to the Vercel frontend or append /wp-admin or /wp-json.
# Never put passwords, application passwords or secret keys in VITE_ variables.
# Frontend routes use the visitor's current origin; no frontend URL setting is needed.
